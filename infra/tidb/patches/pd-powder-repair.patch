+func TestPowderReplacementAdvice(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	cluster := mockcluster.NewCluster(ctx, mockconfig.NewTestOptions())
+	for i := uint64(1); i <= 5; i++ {
+		count := 1
+		if i == 5 {
+			count = 100
+		}
+		cluster.AddLabelsStore(i, count, map[string]string{
+			"machine_class": "class", "region": "r1", "zone": "z1", "host": "host" + string(rune('0'+i)),
+		})
+	}
+	cluster.AddLeaderRegionWithRange(42, "", "", 1, 2, 3)
+	strategy := &ReplicaStrategy{
+		r: rand.New(rand.NewSource(1)), checkerName: "rule-checker", cluster: cluster,
+		region: cluster.GetRegion(42),
+	}
+	stores := cluster.GetRegionStores(strategy.region)
+	old := uint64(3)
+	native, _ := strategy.SelectStoreToFix(append(stores[:0:0], stores...), old)
+	require.Equal(t, uint64(4), native)
+
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		require.Equal(t, "/v1/recommend", r.URL.Path)
+		var request powderRequest
+		require.NoError(t, json.NewDecoder(r.Body).Decode(&request))
+		require.Equal(t, "replace", request.Event)
+		require.Equal(t, &old, request.OldStoreID)
+		require.Len(t, request.Candidates, 2)
+		require.Equal(t, uint64(4), request.Candidates[0].StoreID)
+		require.Equal(t, uint64(5), request.Candidates[1].StoreID)
+		w.Header().Set("Content-Type", "application/json")
+		require.NoError(t, json.NewEncoder(w).Encode(powderResponse{
+			Version: 1, ModelID: "toy-v1", RegionID: 42, Epoch: request.Epoch, StoreID: 5,
+		}))
+	}))
+	defer server.Close()
+	t.Setenv("POWDER_ORACLE_URL", server.URL+"/v1/recommend")
+	t.Setenv("POWDER_ORACLE_MODEL_ID", "toy-v1")
+	target, filtered := strategy.SelectStoreToFix(append(stores[:0:0], stores...), old)
+	require.False(t, filtered)
+	require.Equal(t, uint64(5), target)
+
+	t.Setenv("POWDER_ORACLE_MODEL_ID", "wrong-model")
+	target, _ = strategy.SelectStoreToFix(append(stores[:0:0], stores...), old)
+	require.Equal(t, native, target)
+	t.Setenv("POWDER_ORACLE_URL", "http://example.com:8650/v1/recommend")
+	target, _ = strategy.SelectStoreToFix(append(stores[:0:0], stores...), old)
+	require.Equal(t, native, target)
+}
+
+func (suite *ruleCheckerTestSuite) TestPowderOfflinePeerRepair() {
+	for i := uint64(1); i <= 5; i++ {
+		suite.cluster.AddLeaderStore(i, 1)
+	}
+	suite.cluster.AddLeaderRegionWithRange(42, "", "", 1, 2, 3)
+	suite.cluster.SetStoreOffline(3)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		var request powderRequest
+		suite.Require().NoError(json.NewDecoder(r.Body).Decode(&request))
+		suite.Require().Equal("replace", request.Event)
+		suite.Require().Equal(uint64(3), *request.OldStoreID)
+		suite.Require().NoError(json.NewEncoder(w).Encode(powderResponse{
+			Version: 1, ModelID: "toy-v1", RegionID: 42, Epoch: request.Epoch, StoreID: 5,
+		}))
+	}))
+	defer server.Close()
+	suite.T().Setenv("POWDER_ORACLE_URL", server.URL+"/v1/recommend")
+	suite.T().Setenv("POWDER_ORACLE_MODEL_ID", "toy-v1")
+	op := suite.rc.Check(suite.cluster.GetRegion(42))
+	suite.Require().NotNil(op)
+	suite.Require().Equal("replace-rule-offline-peer", op.Desc())
+	suite.Require().Equal(uint64(5), op.Step(0).(operator.AddLearner).ToStore)
+}
