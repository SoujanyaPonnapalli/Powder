+package checker
+
+import (
+	"bytes"
+	"encoding/json"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
+	"sort"
+	"time"
+
+	"github.com/pingcap/kvproto/pkg/metapb"
+	"github.com/pingcap/log"
+	"github.com/tikv/pd/pkg/core"
+	"github.com/tikv/pd/pkg/schedule/filter"
+	"go.uber.org/zap"
+)
+
+const powderOracleTimeout = 200 * time.Millisecond
+
+var powderHTTPClient = &http.Client{
+	Timeout:       powderOracleTimeout,
+	CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse },
+}
+
+type powderEpoch struct {
+	Version uint64 `json:"version"`
+	ConfVer uint64 `json:"conf_ver"`
+}
+
+type powderStore struct {
+	StoreID uint64            `json:"store_id"`
+	Labels  map[string]string `json:"labels"`
+}
+
+type powderPeer struct {
+	powderStore
+	Role    string `json:"role"`
+	Witness bool   `json:"witness"`
+	Down    bool   `json:"down"`
+	Pending bool   `json:"pending"`
+}
+
+type powderCandidate struct {
+	powderStore
+	RegionScore int `json:"region_score"`
+}
+
+type powderRequest struct {
+	Version    int               `json:"version"`
+	ModelID    string            `json:"model_id"`
+	Event      string            `json:"event"`
+	RegionID   uint64            `json:"region_id"`
+	Epoch      powderEpoch       `json:"epoch"`
+	OldStoreID *uint64           `json:"old_store_id"`
+	Peers      []powderPeer      `json:"peers"`
+	Candidates []powderCandidate `json:"candidates"`
+}
+
+type powderResponse struct {
+	Version  int         `json:"version"`
+	ModelID  string      `json:"model_id"`
+	RegionID uint64      `json:"region_id"`
+	Epoch    powderEpoch `json:"epoch"`
+	StoreID  uint64      `json:"store_id"`
+}
+
+func powderStoreInfo(store *core.StoreInfo) powderStore {
+	labels := make(map[string]string, 4)
+	for _, key := range []string{"machine_class", "region", "zone", "host"} {
+		labels[key] = store.GetLabelValue(key)
+	}
+	return powderStore{StoreID: store.GetID(), Labels: labels}
+}
+
+// powderSelectStore only advises the normal PD checker: candidates have already
+// passed its isolation, rule, storage and strict temporary-state filters.
+// Unavailable/invalid advice falls back to PD; a changed Region waits for the next patrol.
+func (s *ReplicaStrategy) powderSelectStore(event string, old uint64, candidates []*core.StoreInfo) (selected *core.StoreInfo, stale bool) {
+	endpoint := os.Getenv("POWDER_ORACLE_URL")
+	modelID := os.Getenv("POWDER_ORACLE_MODEL_ID")
+	if endpoint == "" || modelID == "" {
+		return nil, false
+	}
+	u, err := url.Parse(endpoint)
+	if err != nil || u.Scheme != "http" || (u.Hostname() != "127.0.0.1" && u.Hostname() != "::1") || u.Port() == "" || u.Path != "/v1/recommend" {
+		return nil, false
+	}
+	epoch := s.region.GetRegionEpoch()
+	defer func() {
+		current := s.cluster.GetRegion(s.region.GetID())
+		if current == nil || current.GetRegionEpoch().GetVersion() != epoch.GetVersion() || current.GetRegionEpoch().GetConfVer() != epoch.GetConfVer() {
+			selected, stale = nil, true
+		}
+	}()
+	request := powderRequest{
+		Version: 1, ModelID: modelID, Event: event, RegionID: s.region.GetID(),
+		Epoch:      powderEpoch{Version: epoch.GetVersion(), ConfVer: epoch.GetConfVer()},
+		Peers:      make([]powderPeer, 0, len(s.region.GetPeers())),
+		Candidates: make([]powderCandidate, 0, len(candidates)),
+	}
+	if event == "replace" {
+		request.OldStoreID = &old
+	}
+	for _, peer := range s.region.GetPeers() {
+		store := s.cluster.GetStore(peer.GetStoreId())
+		if store == nil {
+			return nil, false
+		}
+		role := "voter"
+		if peer.GetRole() != metapb.PeerRole_Voter {
+			role = "learner"
+		}
+		request.Peers = append(request.Peers, powderPeer{
+			powderStore: powderStoreInfo(store), Role: role, Witness: peer.GetIsWitness(),
+			Down: s.region.GetDownPeer(peer.GetId()) != nil, Pending: s.region.GetPendingPeer(peer.GetId()) != nil,
+		})
+	}
+	// Sort a copy so the candidate iteration order in PD stays unchanged on fallback.
+	sorted := append([]*core.StoreInfo(nil), candidates...)
+	cmp := filter.RegionScoreComparer(s.cluster.GetCheckerConfig())
+	sort.Slice(sorted, func(i, j int) bool {
+		if score := cmp(sorted[i], sorted[j]); score != 0 {
+			return score < 0
+		}
+		return sorted[i].GetID() < sorted[j].GetID()
+	})
+	for rank, store := range sorted {
+		request.Candidates = append(request.Candidates, powderCandidate{powderStore: powderStoreInfo(store), RegionScore: rank})
+	}
+	body, err := json.Marshal(request)
+	if err != nil {
+		return nil, false
+	}
+	resp, err := powderHTTPClient.Post(u.String(), "application/json", bytes.NewReader(body))
+	if err != nil {
+		log.Debug("Powder oracle unavailable", zap.Error(err))
+		return nil, false
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		return nil, false
+	}
+	data, err := io.ReadAll(io.LimitReader(resp.Body, 4097))
+	if err != nil || len(data) > 4096 {
+		return nil, false
+	}
+	var choice powderResponse
+	if err := json.Unmarshal(data, &choice); err != nil {
+		return nil, false
+	}
+	if choice.StoreID == 0 {
+		return nil, false
+	}
+	if choice.Version != 1 || choice.ModelID != modelID || choice.RegionID != request.RegionID || choice.Epoch != request.Epoch {
+		return nil, false
+	}
+	for _, store := range candidates {
+		if store.GetID() == choice.StoreID {
+			return store, false
+		}
+	}
+	return nil, false
+}
