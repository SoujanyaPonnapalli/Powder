# Copied to ~/.powder-runner.env on the VM. Configure ONE way for Claude Code to authenticate.

# Option A: Anthropic API key
# export ANTHROPIC_API_KEY=sk-ant-...

# Option B: Amazon Bedrock through the instance role (no key on disk).
# The role already allows bedrock:InvokeModel*; enable model access in the Bedrock console first.
# export CLAUDE_CODE_USE_BEDROCK=1
# export AWS_REGION=us-west-2
# export ANTHROPIC_MODEL=<bedrock inference profile id for the Claude model you enabled>

# Optional knobs
# export POWDER_WORK_BRANCH=exec01-fault-library-vm
# export POWDER_BASE_BRANCH=exec01-fault-library
# export POWDER_MAX_TURNS=200
# export POWDER_SESSION_TIMEOUT=3h
