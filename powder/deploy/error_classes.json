{
  "version": 1,
  "source": "pingcap/tidb v8.5.8 pkg/errno/errcode.go (codes); classification is Powder's definition (plan section 7)",
  "outcomes": {
    "timeout": "counts against availability: the request could not be served (client deadline, lost connection, or a TiDB/TiKV/PD unavailability error)",
