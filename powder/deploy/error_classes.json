    {"regex": "connection refused",                                           "outcome": "timeout", "cause": "conn_refused",  "layer": "client"},
    {"regex": "connection reset|broken pipe|bad connection|invalid connection|unexpected EOF|^EOF$", "outcome": "timeout", "cause": "conn_reset", "layer": "client"},
