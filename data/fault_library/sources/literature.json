          "machines_per_100": 9,
          "afr": 0.08
        },
        "unit": "per 100 servers / 14 months",
        "status": "V",
        "location": "SoCC'10 \u00a72.2 (PDF read 2026-10-21)",
        "covers": [
          "hw_host_loss",
          "disk"
        ]
      },
      {
        "id": "repairs-per-repaired",
        "metric_verbatim": "The average number of repairs seen by a repaired machine is 2 ... around 5 machines failed only once. Thus, around 4 machines had more than 1 failure",
        "value": {
          "mean": 2,
          "once": 5,
          "repeat": 4
        },
        "unit": "per 100 servers / 14 months",
        "status": "V",
        "location": "SoCC'10 \u00a72.2, \u00a74.2",
        "covers": []
      },
      {
        "id": "disk-share",
        "metric_verbatim": "a majority (78%) were for hard disks ... 5% due to memory and the rest (18%)",
        "value": {
          "disk": 0.78,
          "memory": 0.05,
          "raid": 0.04,
          "other": 0.18
        },
        "unit": "share of replacements",
        "status": "V",
        "location": "SoCC'10 \u00a73",
        "covers": [],
        "notes": "RAID share by subtraction of the quoted shares (raid ~4%)"
      },
      {
        "id": "disk-afr",
        "metric_verbatim": "hard disks are the number one failing component with an AFR for 2.7%",
        "value": 0.027,
        "unit": "failures per disk-year",
        "status": "V",
        "location": "SoCC'10 \u00a73",
        "covers": [
          "disk"
        ]
      },
      {
        "id": "raid-afr",
        "metric_verbatim": "For overall RAID controllers the failure rate was 0.7% AFR",
        "value": 0.007,
